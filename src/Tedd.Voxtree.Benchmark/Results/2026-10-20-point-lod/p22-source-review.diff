+    private static bool BuildLinearLeaf(ReadOnlySpan<TStorage> source, int start,
+        int rowStride, int planeStride, ref OctreeWriter writer, out SubtreeResult result)
+    {
+        var v0 = source[start];
+        var v1 = source[start + 1];
+        var v2 = source[start + rowStride];
+        var v3 = source[start + rowStride + 1];
+        var v4 = source[start + planeStride];
+        var v5 = source[start + planeStride + 1];
+        var v6 = source[start + planeStride + rowStride];
+        var v7 = source[start + planeStride + rowStride + 1];
+        if (v1.Equals(v0) && v2.Equals(v0) && v3.Equals(v0) && v4.Equals(v0) && v5.Equals(v0) && v6.Equals(v0) && v7.Equals(v0))
+        {
+            result = SubtreeResult.Uniform(v0);
+            return true;
+        }
+        var nodeOffset = writer.Position;
+        if (!writer.WriteByte(255) || !writer.WriteValue(v0) || !writer.WriteValue(v1) || !writer.WriteValue(v2) || !writer.WriteValue(v3) || !writer.WriteValue(v4) || !writer.WriteValue(v5) || !writer.WriteValue(v6) || !writer.WriteValue(v7))
+        {
+            result = default;
+            return false;
+        }
+        result = SubtreeResult.Node(nodeOffset);
+        return true;
     }
 
