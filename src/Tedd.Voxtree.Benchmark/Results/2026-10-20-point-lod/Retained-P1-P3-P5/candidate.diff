diff --git a/src/Tedd.Voxtree/PackedVoxelSearch.cs b/src/Tedd.Voxtree/PackedVoxelSearch.cs
index 7c04a45..f413d86 100644
--- a/src/Tedd.Voxtree/PackedVoxelSearch.cs
+++ b/src/Tedd.Voxtree/PackedVoxelSearch.cs
@@ -8,6 +8,20 @@ namespace Tedd.Voxtree;
 
 internal static class PackedVoxelSearch
 {
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    internal static bool TryReadByteToken(ReadOnlySpan<byte> data, int cursor, int child, out uint token)
+    {
+        token = 0;
+        if (data.Length - cursor < sizeof(ulong)) return false;
+        var packed = BinaryPrimitives.ReadUInt64LittleEndian(data.Slice(cursor, sizeof(ulong)));
+        // Only preceding tokens and the selected token must be single-byte.
+        // A continuation in a later sibling does not affect this read.
+        var prefixMask = 0x8080808080808080UL >> ((7 - child) * 8);
+        if ((packed & prefixMask) != 0) return false;
+        token = (byte)(packed >> (child * 8));
+        return true;
+    }
+
